{
  "name": "ossido-site",
  "description": "Basic ossido application with tailwind",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dev": "ossido dev",
    "bake": "bun run scripts/bake-cube.ts",
    "encode-textures": "bun run scripts/encode-textures.ts",
    "build-api-reference": "bun run scripts/build-api-reference.ts",
    "build": "rm -rf ./out && ossido build",
    "serve": "bunx serve ./out/static",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-stately/utils": "^3.12.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@untitledui/icons": "^0.0.22",
    "input-otp": "^1.4.2",
    "minisearch": "^7.2.0",
    "@ossido-labs/ossido": "0.1.4",
    "@ossido-labs/ossido-mdx": "0.1.4",
    "@ossido-labs/ossido-react-vite-plugin": "0.1.4",
    "@ossido-labs/ossido-router": "0.1.4",
    "@ossido-labs/ossido-ui": "0.1.4",
    "postprocessing": "^6.39.4",
    "react": "^19.0.0",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.0.0",
    "react-shiki": "^0.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@ossido-labs/ossido-eslint-plugin": "0.1.4",
    "@oxlint/plugins": "1.77.0",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "estree-util-value-to-estree": "^3.5.0",
    "github-slugger": "^2.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "mdast-util-to-string": "^4.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "1.77.0",
    "playwright": "^1.62.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "storybook": "^10.5.6",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
